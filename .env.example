# Telegram
TG_TOKEN=your_telegram_bot_token

# PostgreSQL
DB_NAME=tgbot
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Redis
REDIS_PORT=6379

# Admins (space separated)
ADMIN_IDS=123 321

# Ollama Cloud
OLLAMA_API_KEY=sk-ollama-
OLLAMA_BASE_URL=https://api.ollama.com/v1
OLLAMA_GPT_MODEL=gpt-oss:20b-cloud
OLLAMA_QWEN_MODEL=qwen3.5:cloud
OLLAMA_CLAUDE_MODEL=qwen3-coder-next:cloud
OLLAMA_ADMIN_MODEL=kimi-k2.6:cloud

# OpenAI (image gen + Whisper)
OPENAI_API_KEY=sk-proj-
OPENAI_MODEL=gpt-4o-mini
OPENAI_ADMIN_MODEL=gpt-4o
OPENAI_ADMIN_TOKEN_LIMIT=

# Legacy (optional)
QWEN_API_KEY=
QWEN_MODEL=qwen-max
QWEN_IMAGE_MODEL=qwen-vl-plus
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Video gen
GEN_VIDEO_API_KEY=YOUR_API_KEY
GEN_VIDEO_ASPECT_RATIO=16:9
GEN_VIDEO_DURATION=10

# Image gen
GEN_IMAGE_MODEL=dall-e-3
GEN_IMAGE_SIZE=1024x1024
GEN_IMAGE_QUALITY=standard

# System
TIMEZONE=Europe/Moscow
